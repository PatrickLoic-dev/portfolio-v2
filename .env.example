# Copy to .env.local. Local values come from `npx supabase status`.

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection used by Drizzle (Project settings → Database → connection string)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# The only account allowed into /studio. `npm run db:seed` creates it with this password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Steam sync (Studio → Passions → Jeux vidéo) — https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# Protects /api/cron/steam (nightly sync on Vercel)
CRON_SECRET=

# Contact form (optional) — https://resend.com
RESEND_API_KEY=
CONTACT_FROM=
# Newsletter sender (defaults to CONTACT_FROM). Must be on a domain verified in Resend.
NEWSLETTER_FROM=
# Absolute site address used in emails (on Vercel the production domain is detected).
NEXT_PUBLIC_SITE_URL=

# Claude in the Studio (EN↔FR translation, social post drafts) — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Direct publishing from the Studio (Réseaux sociaux → Comptes shows the callback URLs)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
